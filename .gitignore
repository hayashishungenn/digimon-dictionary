!data/raw/.gitkeep
!data/normalized/.gitkeep
!data/reports/.gitkeep

# Database (regenerable via sync-data)
*.sqlite
*.sqlite3
*.db
exports/
!exports/.gitkeep

# Runtime sync state
data/.sync_state.json
data/.http_cache/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Env / secrets
.env
